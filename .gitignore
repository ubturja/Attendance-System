# =============================================================================
# MTS Attendance HRMS — monorepo .gitignore
# Covers root + hrms-backend (Laravel) + hrms-frontend (Vite/React)
# =============================================================================

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.phpactor.json
.nova/
.zed/
.codex/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment secrets (keep *.example / .env.development tracked)
.env
.env.backup
.env.local
.env.*.local
.env.production
!.env.example
!.env.development

# Temporary / cache
.cache/
tmp/
temp/
coverage/
.nyc_output/
.phpunit.result.cache
.phpunit.cache/

# ---------------------------------------------------------------------------
# Backend (Laravel)
# ---------------------------------------------------------------------------
hrms-backend/vendor/
hrms-backend/node_modules/
hrms-backend/auth.json
hrms-backend/public/build/
hrms-backend/public/hot
hrms-backend/public/storage
hrms-backend/public/fonts-manifest.dev.json
hrms-backend/storage/*.key
hrms-backend/storage/pail
hrms-backend/storage/logs/*
!hrms-backend/storage/logs/.gitignore
hrms-backend/storage/framework/cache/data/*
!hrms-backend/storage/framework/cache/data/.gitignore
hrms-backend/storage/framework/sessions/*
!hrms-backend/storage/framework/sessions/.gitignore
hrms-backend/storage/framework/views/*
!hrms-backend/storage/framework/views/.gitignore
hrms-backend/bootstrap/cache/*.php
!hrms-backend/bootstrap/cache/.gitignore
hrms-backend/_ide_helper.php
hrms-backend/Homestead.json
hrms-backend/Homestead.yaml

# ---------------------------------------------------------------------------
# Frontend (Vite / React)
# ---------------------------------------------------------------------------
hrms-frontend/node_modules/
hrms-frontend/dist/
hrms-frontend/dist-ssr/
