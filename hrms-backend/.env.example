APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# React SPA origin(s) for CORS (comma-separated). Used when the frontend calls
# the API directly instead of through the Vite dev proxy.
FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# DATABASE CONFIGURATION — MTS Attendance HRMS (Phase 1)
# =============================================================================
# Primary persistence layer for the HRMS backend. Per SystemArchitecture.md,
# all Eloquent models, migrations, and relational constraints MUST target MySQL.
# Schema design follows ERD.md (users, teams, leave_types,
# user_yearly_leave_records, attendance_logs).
#
# Setup: copy this file to .env, then create the database locally:
#   CREATE DATABASE hrms_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Assign DB_PASSWORD to match your local MySQL root (or dedicated app user).
# =============================================================================

# DB_CONNECTION: Laravel database driver. Must remain "mysql" for this project.
DB_CONNECTION=mysql

# DB_HOST: MySQL server hostname. 127.0.0.1 for local; override in staging/prod.
DB_HOST=127.0.0.1

# DB_PORT: Default MySQL port. Change only if your instance listens elsewhere.
DB_PORT=3306

# DB_DATABASE: Dedicated schema for MTS Attendance HRMS relational data.
DB_DATABASE=hrms_db

# DB_USERNAME: MySQL account with DDL/DML privileges on hrms_db (local: root).
DB_USERNAME=root

# DB_PASSWORD: MySQL password for DB_USERNAME. Empty for typical local root;
# set a strong value in staging/production and never commit real secrets here.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
